{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "{src/**,branding/**}",
      "excludeFiles": "{tests/**,db/**,configs/**,results/**,templates/**,docs/**,data/**,reports/**,**/__pycache__/**}"
    }
  }
}
