# Copy to .env (gitignored) and fill in. Real environment variables override this file.

# Groq (OpenAI-compatible). With only GROQ_API_KEY set, the base URL defaults to Groq.
GROQ_API_KEY=
# Optional; any chat model your Groq account offers.
GROQ_MODEL=openai/gpt-oss-120b

# Or any other OpenAI-compatible server (overrides Groq when set)
# SALUD_LLM_BASE_URL=http://localhost:11434/v1
# SALUD_LLM_MODEL=
# SALUD_LLM_API_KEY=

# Team database: Neon Postgres project salud-pipeline. Ask the team lead; never commit the real values.
DATABASE_URL=
# Team lead only (schema changes with salud-db setup):
DATABASE_URL_UNPOOLED=
# Tests only: the Neon 'tests' branch, never the live database.
DATABASE_URL_TEST=

# Team website on Vercel only (set in the Vercel project, not needed on laptops).
TEAM_PASSCODE=
